# Python
__pycache__/
*.pyc
.venv/
venv/
auditor/

# Environment variables — never commit real API keys
.env

# Raw Safety Gate XML downloads (large, can be re-downloaded)
notes/raw/

# Built from notes/raw/ by data/fetch_rapex.py (re-creatable in seconds)
data/alerts.jsonl
data/alerts_grouped.jsonl
data/knowledge.jsonl
data/dev.jsonl
data/test.jsonl
data/test_near_twins.txt

# Trained models (these are generated, not source code)
*.pkl

# OS junk
.DS_Store

# IDE
.vscode/
.idea/

# Rebuilt by python -m boxes.preprocessing and python -m boxes.build_embeddings
data/splits/
data/embeddings/

# Quarto output (rebuilt by quarto render)
data_report.html
data_report_files/

# ChromaDB database (rebuilt by python -m boxes.build_chroma)
data/chroma/

# Probe cache (rebuilt when a probe runs)
reports/probe_results/cache/

# Rendered probe report (rebuilt by quarto render reports/probe.qmd)
reports/probe.html
reports/probe.pdf
reports/probe_files/
